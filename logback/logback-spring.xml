<?xml version="1.0" encoding="UTF-8"?>
<!--
  spring-fleet logging convention.

  Drop this into a service's src/main/resources/logback-spring.xml (or merge the
  appender + pattern into an existing one). It writes a rolling log file into a
  shared directory so spring-fleet can correlate logs across services.

  Two things make correlation work:
    1) FILE_PATH points every service at the same logDir, one file per service.
    2) The pattern embeds your trace keys via %X{key} (MDC), so a request can be
       followed across services by its OTel trace_id (and/or legacy sessionId
       / requestId).

  Trace keys (in priority order, matches scan_repos.py defaults):
    - trace_id, span_id : Micrometer Observation / OpenTelemetry. W3C
      traceparent is auto-propagated by Spring Boot 3.x+ when the OTel starter
      (or spring-boot-starter-actuator + Micrometer Tracing) is on the
      classpath. trace_id is a 32-char lowercase hex string and is the modern
      primary correlation key.
    - sessionId, requestId : legacy MDC keys for older Spring fleets that
      pre-date the Observation API. Kept as fallback.

  Replace:
    - ${SPRING_FLEET_LOG_DIR}  -> your config "logDir" (or set the env var)
    - SERVICE_NAME             -> this service's spring-fleet "name"
    - the %X{...} keys          -> match your config "traceKeys"
-->
<configuration>

  <property name="SPRING_FLEET_LOG_DIR"
            value="${SPRING_FLEET_LOG_DIR:-${user.home}/.spring-fleet-logs}"/>
  <property name="SERVICE_NAME" value="SERVICE_NAME"/>

  <!-- Trace keys are surfaced via MDC. Add/remove %X{...} to match traceKeys.
       trace_id / span_id are the Micrometer Observation conventions, set
       automatically when Micrometer Tracing or the OpenTelemetry starter is on
       the classpath. sessionId / requestId are kept as a legacy fallback. -->
  <property name="FLEET_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [trace_id=%X{trace_id:-} span_id=%X{span_id:-} sessionId=%X{sessionId:-} requestId=%X{requestId:-}] %logger{36} - %msg%n"/>

  <appender name="FLEET_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${SPRING_FLEET_LOG_DIR}/${SERVICE_NAME}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${SPRING_FLEET_LOG_DIR}/${SERVICE_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>7</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>${FLEET_PATTERN}</pattern>
    </encoder>
  </appender>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${FLEET_PATTERN}</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="FLEET_FILE"/>
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>
