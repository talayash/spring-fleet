{
  "name": "spring-fleet",
  "version": "0.1.1",
  "description": "Navigate, trace, and debug a fleet of multi-repo Spring Boot microservices. Cross-repo call-chain tracing and trace-key-driven log correlation, driven by a single config file.",
  "author": {
    "name": "Tal Ayash",
    "url": "https://github.com/talayash"
  },
  "homepage": "https://github.com/talayash/spring-fleet",
  "repository": "https://github.com/talayash/spring-fleet",
  "license": "MIT",
  "keywords": [
    "spring-boot",
    "microservices",
    "java",
    "debugging",
    "tracing",
    "monorepo",
    "multi-repo",
    "observability",
    "opentelemetry",
    "mcp",
    "spring-ai"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/statusline.py\""
  }
}
